// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// VWMA(5m) / WMA(15s) Proximity & Long Setup
// ------------------------------------------------------------
//  • 5-minute VWMA (length 14)   – pulled via request.security
//  • 15-second WMA (length 200)  – pulled via request.security
//  • Closeness of price to each average (% and points)
//  • Which average is on top (VWMA vs WMA) and the spread between them
//  • When price crosses the 5m VWMA
//  • LONG SETUP = 5m VWMA > 15s WMA  AND  price crosses UP through the 5m VWMA
//  • Two sets of three MACDs (8/22/9, 12/30/12, 72/200/12): set 1 on 5m, set 2 on 15s
//  • 15s VWMA(21) and VWMA(72): LONG needs the 21 BELOW the 72
//  • TREND (riding) state for LONG: price > 15m WMA(21), 15s WMA(200) > 5m VWMA,
//    15s VWMA 21 < 72, 5m MACDs (2+ green or 72/200/12 green), 15s MACDs all green. SHORT = mirror.
//  • Trading hours: 02:00-15:50 New York time, Mon-Fri, skipping 09:30-09:40 (first 10 min of the open).
//
// Notes
//  • Seconds-based timeframes ("15S") need a TradingView plan with seconds data.
//  • Best used on a chart of 1 minute or lower (15S, 30S, 1m).
//    On charts above 15s the WMA value is the one from the last 15s bar inside each chart bar.
//  • The symbol must report volume for the VWMA to be meaningful.

//@version=6
indicator("VWMA(5m) / WMA(15s) Proximity & Long Setup", shorttitle = "VWMA/WMA Prox", overlay = true, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpMA    = "Moving averages"
vwmaTF   = input.timeframe("5",   "VWMA timeframe", group = grpMA)
vwmaLen  = input.int(14,          "VWMA length", minval = 1, group = grpMA)
wmaTF    = input.timeframe("15S", "WMA timeframe", group = grpMA)
wmaLen   = input.int(200,         "WMA length", minval = 1, group = grpMA)
noRepaint = input.bool(false, "Non-repainting higher-timeframe data (use last CLOSED bar)", group = grpMA,
     tooltip = "Applies to the 5m VWMA, the 5m MACD set and the 15m WMA.\nOff = live values that update while the 5m bar is forming (matches a 5m chart).\nOn = uses the last completed 5m bar only, so historical values never change.")

grpSig    = "Signals"
crossMode = input.string("Close crosses", "Cross definition", options = ["Close crosses", "Bar pierces"], group = grpSig,
     tooltip = "Close crosses: close moves from one side of the VWMA to the other.\nBar pierces: the bar's high/low range touches the VWMA and it closes on one side.")
nearPct   = input.float(0.10, "'Near' threshold (%)", minval = 0.0, step = 0.01, group = grpSig,
     tooltip = "Price is flagged NEAR an average when it is within this % of it.")
showShort = input.bool(true, "Show SHORT setups on the chart", group = grpSig,
     tooltip = "Controls the SHORT setup labels, setup background and SHORT setup alerts.\nSHORT trend dots and background are controlled in the Trend riding section.")
gapThr    = input.float(0.10, "Tight gap threshold (%)", minval = 0.0, step = 0.01, group = grpSig,
     tooltip = "The averages count as TIGHT when the gap between the 5m VWMA and the 15s WMA is this % or less (either side).")
gapIdealThr = input.float(0.06, "Ideal gap threshold (%)", minval = 0.0, step = 0.01, group = grpSig,
     tooltip = "The averages count as IDEAL when the gap is this % or less (either side). Setups here are graded A+.")
gapReq    = input.string("Tight or better", "Gap required for setups", options = ["Tight or better", "Ideal only", "None (grade only)"], group = grpSig,
     tooltip = "Tight or better: setups only fire when the gap is at or below the tight threshold (0.10%).\nIdeal only: only at or below the ideal threshold (0.06%).\nNone: setups fire at any gap, labelled with a grade.\nGrades: A+ = ideal gap, A = tight gap, B = wider.")

grpMacd   = "MACDs"
macdTF1   = input.timeframe("5",   "Set 1 timeframe", group = grpMacd)
macdTF2   = input.timeframe("15S", "Set 2 timeframe", group = grpMacd)
mAf = input.int(8,  "MACD A  fast", minval = 1, group = grpMacd, inline = "mA")
mAs = input.int(22, "slow",         minval = 1, group = grpMacd, inline = "mA")
mAg = input.int(9,  "signal",       minval = 1, group = grpMacd, inline = "mA")
mBf = input.int(12, "MACD B  fast", minval = 1, group = grpMacd, inline = "mB")
mBs = input.int(30, "slow",         minval = 1, group = grpMacd, inline = "mB")
mBg = input.int(12, "signal",       minval = 1, group = grpMacd, inline = "mB")
mCf = input.int(72, "MACD C  fast", minval = 1, group = grpMacd, inline = "mC")
mCs = input.int(200, "slow",        minval = 1, group = grpMacd, inline = "mC")
mCg = input.int(12, "signal",       minval = 1, group = grpMacd, inline = "mC")
useMacd   = input.bool(true, "Require MACD filter for LONG / SHORT setups", group = grpMacd,
     tooltip = "LONG needs:\n• 5m set: at least 2 of 3 green, OR the 72/200/12 green\n• 15s set: all 3 green\nSHORT uses the mirror image (red).")
sigType   = input.string("SMA", "Signal line MA type", options = ["SMA", "EMA"], group = grpMacd,
     tooltip = "How the signal line is smoothed. SMA matches the MACD indicators on your chart; EMA is the classic MACD (ta.macd).")
greenMode = input.string("Histogram > 0", "A MACD counts as green when", options = ["Histogram > 0", "Histogram > 0 and MACD > 0"], group = grpMacd,
     tooltip = "Histogram > 0: MACD line is above its signal line.\nHistogram > 0 and MACD > 0: also requires the MACD line to be above zero.\nRed is the mirror image.")

grpVw     = "15s VWMAs"
vwTF      = input.timeframe("15S", "Timeframe", group = grpVw)
vwFastLen = input.int(21, "Fast VWMA length", minval = 1, group = grpVw)
vwSlowLen = input.int(72, "Slow VWMA length", minval = 1, group = grpVw)
useVwStack = input.bool(true, "Require fast VWMA BELOW slow VWMA for LONG", group = grpVw,
     tooltip = "LONG needs the 15s VWMA(21) below the 15s VWMA(72).\nSHORT uses the mirror image (21 above 72).")
showVw    = input.bool(true, "Plot the 15s VWMAs", group = grpVw)
colVwF    = input.color(color.new(#AB47BC, 0), "Fast VWMA color", group = grpVw)
colVwS    = input.color(color.new(#00BCD4, 0), "Slow VWMA color", group = grpVw)

grpTr     = "Trend riding"
trTF      = input.timeframe("15", "Trend WMA timeframe", group = grpTr)
trLen     = input.int(21, "Trend WMA length", minval = 1, group = grpTr)
showTrWma = input.bool(true, "Plot the trend WMA", group = grpTr)
showTrBg  = input.bool(true, "Shade background while a trend is being ridden", group = grpTr)
showTrDot = input.bool(true, "Mark every bar where the trend criteria are met", group = grpTr)
colTrWma  = input.color(color.new(#FFEB3B, 0), "Trend WMA color", group = grpTr)

grpSess   = "Trading hours"
useSess   = input.bool(true, "Only signal during trading hours", group = grpSess,
     tooltip = "Setups, watch states and trend states only fire inside the trading window and outside the no-trade window.")
sessMain  = input.session("0200-1550", "Trading window", group = grpSess)
sessSkip  = input.session("0930-0940", "No-trade window (first 10 min of the open)", group = grpSess)
sessTz    = input.string("America/New_York", "Time zone", group = grpSess,
     tooltip = "IANA time zone name the windows are written in. America/New_York follows US daylight saving automatically.")
showSessBg = input.bool(true, "Grey out bars outside trading hours", group = grpSess)

grpVis    = "Display"
showFill  = input.bool(true,  "Fill between averages (color = which is on top)", group = grpVis)
showCross = input.bool(true,  "Mark every VWMA cross", group = grpVis)
showBg    = input.bool(true,  "Highlight setup bars", group = grpVis)
showTable = input.bool(true,  "Show info table", group = grpVis)
tablePos  = input.string("Top Right", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpVis)
showMacdT = input.bool(true,  "Show MACD table", group = grpVis)
macdPos   = input.string("Bottom Right", "MACD table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpVis)

colVwma   = input.color(color.new(#2962FF, 0), "VWMA color", group = grpVis)
colWma    = input.color(color.new(#FF9800, 0), "WMA color",  group = grpVis)
colBull   = input.color(color.new(#00C853, 0), "Bullish color", group = grpVis)
colBear   = input.color(color.new(#FF1744, 0), "Bearish color", group = grpVis)

// ───────────────────────────── Averages ─────────────────────────────
// 5m VWMA(14). Non-repainting variant: previous 5m value + lookahead_on (standard safe idiom).
vwmaLive   = request.security(syminfo.tickerid, vwmaTF, ta.vwma(close, vwmaLen), lookahead = barmerge.lookahead_off)
vwmaClosed = request.security(syminfo.tickerid, vwmaTF, ta.vwma(close, vwmaLen)[1], lookahead = barmerge.lookahead_on)
vwma5      = noRepaint ? vwmaClosed : vwmaLive

// 15s WMA(200)
wma15 = request.security(syminfo.tickerid, wmaTF, ta.wma(close, wmaLen), lookahead = barmerge.lookahead_off)

// 15s VWMA(21) and VWMA(72)
[vwFast, vwSlow] = request.security(syminfo.tickerid, vwTF, [ta.vwma(close, vwFastLen), ta.vwma(close, vwSlowLen)], lookahead = barmerge.lookahead_off)
vwReady     = not na(vwFast) and not na(vwSlow)
vwFastBelow = vwReady and vwFast < vwSlow              // LONG condition
vwFastAbove = vwReady and vwFast > vwSlow              // SHORT condition (mirror)
vwLongGate  = not useVwStack or vwFastBelow
vwShortGate = not useVwStack or vwFastAbove

// ───────────────────────────── MACDs ─────────────────────────────
// Each call returns MACD line, signal line and histogram for A, B and C.
// `off` = 1 shifts to the previous (closed) bar for the non-repainting 5m option.
// MACD line = EMA(fast) - EMA(slow); signal line = SMA or EMA of the MACD line (see "Signal line MA type")
f_macd(int fastLen, int slowLen, int sigLen) =>
    m      = ta.ema(close, fastLen) - ta.ema(close, slowLen)
    sigSma = ta.sma(m, sigLen)
    sigEma = ta.ema(m, sigLen)
    sg     = sigType == "SMA" ? sigSma : sigEma
    [m, sg, m - sg]

f_macd3(int off) =>
    [ma, sa, ha] = f_macd(mAf, mAs, mAg)
    [mb, sb, hb] = f_macd(mBf, mBs, mBg)
    [mc, sc, hc] = f_macd(mCf, mCs, mCg)
    [ma[off], sa[off], ha[off], mb[off], sb[off], hb[off], mc[off], sc[off], hc[off]]

macdOff1  = noRepaint ? 1 : 0
macdLook1 = noRepaint ? barmerge.lookahead_on : barmerge.lookahead_off

// Set 1 (5m) and Set 2 (15s)
[m1a, s1a, h1a, m1b, s1b, h1b, m1c, s1c, h1c] = request.security(syminfo.tickerid, macdTF1, f_macd3(macdOff1), lookahead = macdLook1)
[m2a, s2a, h2a, m2b, s2b, h2b, m2c, s2c, h2c] = request.security(syminfo.tickerid, macdTF2, f_macd3(0), lookahead = barmerge.lookahead_off)

// Green / red per MACD (see "A MACD counts as green when")
f_green(m, sg) => greenMode == "Histogram > 0" ? m > sg : m > sg and m > 0
f_red(m, sg)   => greenMode == "Histogram > 0" ? m < sg : m < sg and m < 0

g1a = f_green(m1a, s1a), g1b = f_green(m1b, s1b), g1c = f_green(m1c, s1c)
r1a = f_red(m1a, s1a),   r1b = f_red(m1b, s1b),   r1c = f_red(m1c, s1c)
g2a = f_green(m2a, s2a), g2b = f_green(m2b, s2b), g2c = f_green(m2c, s2c)
r2a = f_red(m2a, s2a),   r2b = f_red(m2b, s2b),   r2c = f_red(m2c, s2c)

greens1 = (g1a ? 1 : 0) + (g1b ? 1 : 0) + (g1c ? 1 : 0)
reds1   = (r1a ? 1 : 0) + (r1b ? 1 : 0) + (r1c ? 1 : 0)
greens2 = (g2a ? 1 : 0) + (g2b ? 1 : 0) + (g2c ? 1 : 0)
reds2   = (r2a ? 1 : 0) + (r2b ? 1 : 0) + (r2c ? 1 : 0)

// 5m set: at least 2 of 3 green, OR the 72/200/12 green
macd5Long  = greens1 >= 2 or g1c
macd5Short = reds1   >= 2 or r1c
// 15s set: all 3 green (72/200/12 is the key one; shown separately in the table)
macd15Long  = greens2 == 3
macd15Short = reds2   == 3

macdLongOK  = macd5Long  and macd15Long
macdShortOK = macd5Short and macd15Short
macdLongGate  = not useMacd or macdLongOK
macdShortGate = not useMacd or macdShortOK

// 15m WMA(21) for trend riding (same non-repainting option as the 5m data)
f_wmaOff(int len, int off) => ta.wma(close, len)[off]
trWma = request.security(syminfo.tickerid, trTF, f_wmaOff(trLen, macdOff1), lookahead = macdLook1)

ready = not na(vwma5) and not na(wma15)

// ───────────────────────────── Trading hours ─────────────────────────────
inMain    = not na(time(timeframe.period, sessMain + ":23456", sessTz))   // Mon-Fri trading window
inSkip    = not na(time(timeframe.period, sessSkip + ":23456", sessTz))   // opening no-trade window
inSession = not useSess or (inMain and not inSkip)

// ───────────────────────────── Closeness ─────────────────────────────
distVwmaPct = (close - vwma5) / vwma5 * 100.0
distWmaPct  = (close - wma15) / wma15 * 100.0
distVwmaPts = close - vwma5          // distance in points (price units)
distWmaPts  = close - wma15
nearVwma    = math.abs(distVwmaPct) <= nearPct
nearWma     = math.abs(distWmaPct)  <= nearPct

// ───────────────────────────── MA order ─────────────────────────────
vwmaAbove = vwma5 > wma15
vwmaBelow = vwma5 < wma15
spreadPct = (vwma5 - wma15) / wma15 * 100.0
gapTight  = ready and math.abs(spreadPct) <= gapThr     // averages within the tight-gap threshold
gapIdeal  = ready and math.abs(spreadPct) <= gapIdealThr  // averages within the ideal-gap threshold
gapGate   = gapReq == "Tight or better" ? gapTight : gapReq == "Ideal only" ? gapIdeal : true
gapGrade  = gapIdeal ? "A+" : gapTight ? "A" : "B"
orderFlipBull = ready and vwmaAbove and not vwmaAbove[1]
orderFlipBear = ready and vwmaBelow and not vwmaBelow[1]

// ───────────────────────────── VWMA crosses ─────────────────────────────
closeXUp   = ta.crossover(close, vwma5)
closeXDn   = ta.crossunder(close, vwma5)
pierced    = low <= vwma5 and high >= vwma5
pierceUp   = pierced and close > vwma5
pierceDn   = pierced and close < vwma5

crossUp    = ready and (crossMode == "Close crosses" ? closeXUp : pierceUp)
crossDown  = ready and (crossMode == "Close crosses" ? closeXDn : pierceDn)

// ───────────────────────────── Setups ─────────────────────────────
longBase   = crossUp and vwmaAbove                      // VWMA/WMA part of the long
shortBase  = crossDown and vwmaBelow
longSetup  = longBase and macdLongGate and vwLongGate and gapGate and inSession     // optimum long (MACDs + 15s 21<72 + gap + hours)
shortCross = shortBase and macdShortGate and vwShortGate and gapGate and inSession // short setup condition, independent of the display toggle
shortSetup = showShort and shortCross                   // mirrored short (optional display)
longBlocked  = longBase and not longSetup               // cross happened but MACDs and/or gap said no
shortBlocked = shortBase and not shortCross
f_blockTxt(macdOk, vwOk) =>
    r = not macdOk ? "MACDs" : ""
    r := not vwOk ? (r == "" ? "" : r + " + ") + str.tostring(vwFastLen) + "/" + str.tostring(vwSlowLen) : r
    r := not gapGate ? (r == "" ? "" : r + " + ") + "gap " + str.tostring(math.abs(spreadPct), "0.000") + "%" : r
    r := not inSession ? (r == "" ? "" : r + " + ") + (inSkip ? "opening 10 min" : "outside hours") : r
    "✘ blocked by " + r
longWatch  = ready and inSession and vwmaAbove and nearVwma and not longSetup   // bullish order, price sitting on the VWMA
shortWatch = ready and inSession and vwmaBelow and nearVwma and not shortCross  // bearish order, price sitting on the VWMA

// ───────────────────────────── Trend riding ─────────────────────────────
// LONG: price > 15m WMA(21), 15s WMA(200) > 5m VWMA, 15s VWMA 21 < 72, 5m MACD rule, 15s MACD rule
trReady   = ready and not na(trWma)
tL1 = trReady and close > trWma
tL2 = trReady and wma15 > vwma5
tL3 = vwFastBelow
tL4 = macd5Long
tL5 = macd15Long
trendLongRaw = tL1 and tL2 and tL3 and tL4 and tL5
trendLong    = trendLongRaw and inSession
// SHORT: mirror image
tS1 = trReady and close < trWma
tS2 = trReady and wma15 < vwma5
tS3 = vwFastAbove
tS4 = macd5Short
tS5 = macd15Short
trendShortRaw = tS1 and tS2 and tS3 and tS4 and tS5
trendShort    = trendShortRaw and inSession

// Lists which trend conditions are failing
f_trMiss(c1, c2, c3, c4, c5) =>
    r = ""
    r := c1 ? r : r + (r == "" ? "" : ", ") + "price/15m WMA"
    r := c2 ? r : r + (r == "" ? "" : ", ") + "WMA/VWMA"
    r := c3 ? r : r + (r == "" ? "" : ", ") + str.tostring(vwFastLen) + "/" + str.tostring(vwSlowLen)
    r := c4 ? r : r + (r == "" ? "" : ", ") + "5m MACDs"
    r := c5 ? r : r + (r == "" ? "" : ", ") + "15s MACDs"
    r

// ───────────────────────────── Plots ─────────────────────────────
pV = plot(vwma5, "5m VWMA", color = colVwma, linewidth = 2)
pW = plot(wma15, "15s WMA", color = colWma,  linewidth = 2)
plot(showVw ? vwFast : na, "15s VWMA fast", color = colVwF, linewidth = 1)
plot(showVw ? vwSlow : na, "15s VWMA slow", color = colVwS, linewidth = 1)
plot(showTrWma ? trWma : na, "15m WMA (trend)", color = colTrWma, linewidth = 2, style = plot.style_stepline)
fill(pV, pW, color = showFill ? (vwmaAbove ? color.new(colBull, 85) : color.new(colBear, 85)) : na, title = "Order fill")

plotshape(showCross and crossUp   and not longSetup,  "VWMA cross up",   shape.triangleup,   location.belowbar, color.new(colBull, 40), size = size.tiny)
plotshape(showCross and crossDown and not shortSetup, "VWMA cross down", shape.triangledown, location.abovebar, color.new(colBear, 40), size = size.tiny)
// Trend criteria met: a dot under (long) / over (short) every qualifying bar
plotshape(showTrDot and trendLong,                "LONG trend criteria met",  shape.circle, location.belowbar, colBull, size = size.tiny)
plotshape(showTrDot and trendShort, "SHORT trend criteria met", shape.circle, location.abovebar, colBear, size = size.tiny)

// Setup labels (labels don't count toward TradingView's 64-plot limit)
f_gradeCol(c) => gapIdeal ? c : gapTight ? color.new(c, 25) : color.new(c, 55)
if longSetup
    label.new(bar_index, low, "LONG " + gapGrade, yloc = yloc.belowbar, style = label.style_label_up, color = f_gradeCol(colBull), textcolor = color.white, size = size.small)
if shortSetup
    label.new(bar_index, high, "SHORT " + gapGrade, yloc = yloc.abovebar, style = label.style_label_down, color = f_gradeCol(colBear), textcolor = color.white, size = size.small)

bgcolor(showBg and longSetup  ? color.new(colBull, 85) : na, title = "Long setup bg")
bgcolor(showBg and shortSetup ? color.new(colBear, 85) : na, title = "Short setup bg")
bgcolor(showTrBg and trendLong ? color.new(colBull, 93) : na, title = "Long trend bg")
bgcolor(showTrBg and trendShort ? color.new(colBear, 93) : na, title = "Short trend bg")
bgcolor(showSessBg and useSess and not (inMain and not inSkip) ? color.new(color.gray, 88) : na, title = "Outside trading hours")

// Data-window values (hidden on chart)
plot(distVwmaPct, "Price vs VWMA %", display = display.data_window)
plot(distWmaPct,  "Price vs WMA %",  display = display.data_window)
plot(distVwmaPts, "Price vs VWMA (pts)", display = display.data_window)
plot(distWmaPts,  "Price vs WMA (pts)",  display = display.data_window)
plot(spreadPct,   "VWMA - WMA spread %", display = display.data_window)
plot(vwFast - vwSlow, "15s VWMA fast - slow (pts)", display = display.data_window)
plot(trWma, "15m WMA value", display = display.data_window)
plot(trendLong ? 1 : trendShort ? -1 : 0, "Trend state (1 long, -1 short)", display = display.data_window)
plot(vwmaAbove ? 1 : vwmaBelow ? -1 : 0, "Order (1 = VWMA above, -1 = below)", display = display.data_window)

// ───────────────────────────── Table ─────────────────────────────
f_pos(s) =>
    switch s
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

var table tbl = table.new(f_pos(tablePos), 3, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

f_cell(c, r, txt, tc) =>
    table.cell(tbl, c, r, txt, text_color = tc, text_size = size.small, text_halign = text.align_left)

fmtPct = "+0.000;-0.000"

// Signed point distance, shown to the symbol's tick precision
f_pts(x) =>
    na(x) ? "n/a" : (x >= 0 ? "+" : "-") + str.tostring(math.abs(x), format.mintick)
barsSinceX = ta.barssince(crossUp or crossDown)
lastXUp    = ta.barssince(crossUp) == barsSinceX

if showTable and barstate.islast
    txtCol = color.white
    f_cell(0, 0, "Metric", color.gray)
    f_cell(1, 0, "Value",  color.gray)
    f_cell(2, 0, "Status", color.gray)

    f_cell(0, 1, vwmaTF + " VWMA(" + str.tostring(vwmaLen) + ")", colVwma)
    f_cell(1, 1, str.tostring(vwma5, format.mintick), txtCol)
    f_cell(2, 1, noRepaint ? "closed bar" : "live", color.gray)

    f_cell(0, 2, wmaTF + " WMA(" + str.tostring(wmaLen) + ")", colWma)
    f_cell(1, 2, str.tostring(wma15, format.mintick), txtCol)
    f_cell(2, 2, "", txtCol)

    f_cell(0, 3, "Price ↔ VWMA", txtCol)
    f_cell(1, 3, str.tostring(distVwmaPct, fmtPct) + "%  |  " + f_pts(distVwmaPts) + " pts", txtCol)
    f_cell(2, 3, nearVwma ? "NEAR" : (close > vwma5 ? "above" : "below"), nearVwma ? color.yellow : (close > vwma5 ? colBull : colBear))

    f_cell(0, 4, "Price ↔ WMA", txtCol)
    f_cell(1, 4, str.tostring(distWmaPct, fmtPct) + "%  |  " + f_pts(distWmaPts) + " pts", txtCol)
    f_cell(2, 4, nearWma ? "NEAR" : (close > wma15 ? "above" : "below"), nearWma ? color.yellow : (close > wma15 ? colBull : colBear))

    f_cell(0, 5, "MA order", txtCol)
    f_cell(1, 5, (vwmaAbove ? "VWMA > WMA" : vwmaBelow ? "VWMA < WMA" : "VWMA = WMA") + "  (" + str.tostring(spreadPct, fmtPct) + "%)", txtCol)
    f_cell(2, 5, (vwmaAbove ? "BULLISH" : vwmaBelow ? "BEARISH" : "FLAT") + (gapIdeal ? " · IDEAL" : gapTight ? " · TIGHT" : ""), gapTight ? color.yellow : vwmaAbove ? colBull : vwmaBelow ? colBear : color.gray)

    f_cell(0, 6, "VWMA cross", txtCol)
    f_cell(1, 6, na(barsSinceX) ? "none yet" : (lastXUp ? "UP " : "DOWN ") + str.tostring(barsSinceX) + " bars ago", txtCol)
    f_cell(2, 6, crossUp ? "CROSSING UP" : crossDown ? "CROSSING DN" : "—", crossUp ? colBull : crossDown ? colBear : color.gray)

    f_cell(0, 7, "LONG setup", txtCol)
    f_cell(1, 7, "VWMA>WMA + cross up" + (useMacd ? " + MACDs" : "") + (useVwStack ? " + " + str.tostring(vwFastLen) + "<" + str.tostring(vwSlowLen) : "") + (gapReq == "Tight or better" ? " + gap≤" + str.tostring(gapThr) + "%" : gapReq == "Ideal only" ? " + gap≤" + str.tostring(gapIdealThr) + "%" : ""), color.gray)
    f_cell(2, 7, longSetup ? "✔ ACTIVE " + gapGrade : longBlocked ? f_blockTxt(macdLongGate, vwLongGate) : longWatch ? "WATCH (near VWMA)" : vwmaAbove ? "waiting for cross" : "✘ order bearish",
         longSetup ? colBull : longBlocked ? colBear : longWatch ? color.yellow : color.gray)

    f_cell(0, 8, "SHORT setup", txtCol)
    f_cell(1, 8, "VWMA<WMA + cross down" + (useMacd ? " + MACDs" : "") + (useVwStack ? " + " + str.tostring(vwFastLen) + ">" + str.tostring(vwSlowLen) : "") + (gapReq == "Tight or better" ? " + gap≤" + str.tostring(gapThr) + "%" : gapReq == "Ideal only" ? " + gap≤" + str.tostring(gapIdealThr) + "%" : ""), color.gray)
    f_cell(2, 8, shortCross ? "✔ ACTIVE " + gapGrade : shortBlocked ? f_blockTxt(macdShortGate, vwShortGate) : shortWatch ? "WATCH (near VWMA)" : vwmaBelow ? "waiting for cross" : "✘ order bullish",
         shortCross ? colBear : shortBlocked ? colBull : shortWatch ? color.orange : color.gray)

    f_cell(0, 9, vwTF + " VWMA " + str.tostring(vwFastLen) + "/" + str.tostring(vwSlowLen), colVwF)
    f_cell(1, 9, not vwReady ? "n/a" : str.tostring(vwFastLen) + (vwFastBelow ? " < " : vwFastAbove ? " > " : " = ") + str.tostring(vwSlowLen) + "  (" + f_pts(vwFast - vwSlow) + " pts)", txtCol)
    f_cell(2, 9, vwFastBelow ? "LONG ✔" : vwFastAbove ? "LONG ✘ (SHORT ✔)" : "—", vwFastBelow ? colBull : vwFastAbove ? colBear : color.gray)

    f_cell(0, 10, "LONG trend", txtCol)
    f_cell(1, 10, "px>" + trTF + "m WMA" + str.tostring(trLen) + " (" + f_pts(close - trWma) + "), WMA>VWMA, 21<72, MACDs", color.gray)
    f_cell(2, 10, trendLong ? "✔ RIDING" : trendLongRaw ? "✘ " + (inSkip ? "opening 10 min" : "outside hours") : "✘ " + f_trMiss(tL1, tL2, tL3, tL4, tL5), trendLong ? colBull : color.gray)

    f_cell(0, 11, "SHORT trend", txtCol)
    f_cell(1, 11, "px<" + trTF + "m WMA" + str.tostring(trLen) + ", WMA<VWMA, 21>72, MACDs", color.gray)
    f_cell(2, 11, trendShort ? "✔ RIDING" : trendShortRaw ? "✘ " + (inSkip ? "opening 10 min" : "outside hours") : "✘ " + f_trMiss(tS1, tS2, tS3, tS4, tS5), trendShort ? colBear : color.gray)

    f_cell(0, 12, "Trading hours", txtCol)
    f_cell(1, 12, not useSess ? "filter off" : sessMain + " excl. " + sessSkip + " (" + sessTz + ")", color.gray)
    f_cell(2, 12, not useSess ? "—" : inSkip and inMain ? "✘ OPENING 10 MIN" : inMain ? "✔ IN SESSION" : "✘ OUTSIDE HOURS", not useSess ? color.gray : inMain and not inSkip ? colBull : colBear)

// ───────────────────────────── MACD table ─────────────────────────────
var table macdTbl = table.new(f_pos(macdPos), 6, 9, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)

f_mcell(c, r, txt, tc) =>
    table.cell(macdTbl, c, r, txt, text_color = tc, text_size = size.small, text_halign = text.align_left)

f_num(x) =>
    na(x) ? "n/a" : str.tostring(x, "+0.0000;-0.0000")

f_macdRow(r, tf, f, sl, g, m, sg, h) =>
    aboveSig = m > sg
    aboveZero = m > 0
    state = na(m) or na(sg) ? "n/a" : (aboveSig ? "above signal" : m < sg ? "below signal" : "on signal") + " · " + (aboveZero ? "above 0" : m < 0 ? "below 0" : "at 0")
    stateCol = f_green(m, sg) ? colBull : f_red(m, sg) ? colBear : na(m) or na(sg) ? color.gray : color.yellow
    f_mcell(0, r, tf, color.white)
    f_mcell(1, r, str.tostring(f) + "/" + str.tostring(sl) + "/" + str.tostring(g), color.white)
    f_mcell(2, r, f_num(m),  color.white)
    f_mcell(3, r, f_num(sg), color.white)
    f_mcell(4, r, f_num(h),  na(h) ? color.gray : h >= 0 ? colBull : colBear)
    f_mcell(5, r, state, stateCol)

if showMacdT and barstate.islast
    f_mcell(0, 0, "TF",       color.gray)
    f_mcell(1, 0, "MACD",     color.gray)
    f_mcell(2, 0, "Line",     color.gray)
    f_mcell(3, 0, "Signal",   color.gray)
    f_mcell(4, 0, "Hist",     color.gray)
    f_mcell(5, 0, "State",    color.gray)
    f_macdRow(1, macdTF1, mAf, mAs, mAg, m1a, s1a, h1a)
    f_macdRow(2, macdTF1, mBf, mBs, mBg, m1b, s1b, h1b)
    f_macdRow(3, macdTF1, mCf, mCs, mCg, m1c, s1c, h1c)
    f_macdRow(4, macdTF2, mAf, mAs, mAg, m2a, s2a, h2a)
    f_macdRow(5, macdTF2, mBf, mBs, mBg, m2b, s2b, h2b)
    f_macdRow(6, macdTF2, mCf, mCs, mCg, m2c, s2c, h2c)

    // Filter summary rows
    f_mcell(0, 7, macdTF1 + " filter", color.white)
    f_mcell(1, 7, "≥2 green or C green", color.gray)
    f_mcell(2, 7, str.tostring(greens1) + "/3 green", color.white)
    f_mcell(3, 7, "C " + (g1c ? "✔" : "✘"), g1c ? colBull : colBear)
    f_mcell(4, 7, macd5Long ? "LONG ✔" : "LONG ✘", macd5Long ? colBull : color.gray)
    f_mcell(5, 7, macd5Short ? "SHORT ✔" : "SHORT ✘", macd5Short ? colBear : color.gray)

    f_mcell(0, 8, macdTF2 + " filter", color.white)
    f_mcell(1, 8, "all 3 green (C key)", color.gray)
    f_mcell(2, 8, str.tostring(greens2) + "/3 green", color.white)
    f_mcell(3, 8, "C " + (g2c ? "✔" : "✘"), g2c ? colBull : colBear)
    f_mcell(4, 8, macd15Long ? "LONG ✔" : g2c ? "LONG partial (C ✔)" : "LONG ✘", macd15Long ? colBull : g2c ? color.yellow : color.gray)
    f_mcell(5, 8, macd15Short ? "SHORT ✔" : r2c ? "SHORT partial (C ✔)" : "SHORT ✘", macd15Short ? colBear : r2c ? color.orange : color.gray)

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(longSetup,  "LONG setup",           "LONG setup: 5m VWMA > 15s WMA, price crossed UP through 5m VWMA, 15s VWMA 21 < 72, MACD filter passed (if enabled)")
alertcondition(shortSetup, "SHORT setup",          "SHORT setup: 5m VWMA < 15s WMA, price crossed DOWN through 5m VWMA, 15s VWMA 21 > 72, MACD filter passed (if enabled)")
alertcondition(macdLongOK and not macdLongOK[1], "MACD long filter passed", "MACDs now pass the LONG filter (5m: 2+ green or 72/200/12 green; 15s: all 3 green)")
alertcondition(macdShortOK and not macdShortOK[1], "MACD short filter passed", "MACDs now pass the SHORT filter (5m: 2+ red or 72/200/12 red; 15s: all 3 red)")
alertcondition(trendLong and not trendLong[1],   "LONG trend started", "LONG trend conditions all met: price > 15m WMA, 15s WMA > 5m VWMA, 21 < 72, MACDs green")
alertcondition(trendLong[1] and not trendLong,   "LONG trend ended",   "LONG trend broken: at least one trend condition failed")
alertcondition(trendShort and not trendShort[1], "SHORT trend started", "SHORT trend conditions all met: price < 15m WMA, 15s WMA < 5m VWMA, 21 > 72, MACDs red")
alertcondition(trendShort[1] and not trendShort, "SHORT trend ended",   "SHORT trend broken: at least one trend condition failed")
alertcondition(crossUp,    "Price crossed above 5m VWMA", "Price crossed ABOVE the 5m VWMA")
alertcondition(crossDown,  "Price crossed below 5m VWMA", "Price crossed BELOW the 5m VWMA")
alertcondition(orderFlipBull, "VWMA moved above WMA", "5m VWMA crossed ABOVE the 15s WMA (bullish order)")
alertcondition(orderFlipBear, "VWMA moved below WMA", "5m VWMA crossed BELOW the 15s WMA (bearish order)")
alertcondition(longWatch and not longWatch[1], "Long watch", "Bullish order and price is near the 5m VWMA")
alertcondition(shortWatch and not shortWatch[1], "Short watch", "Bearish order and price is near the 5m VWMA")
alertcondition(gapTight and not gapTight[1], "Averages gap tight", "Gap between 5m VWMA and 15s WMA is at or below the tight-gap threshold")
alertcondition(gapIdeal and not gapIdeal[1], "Averages gap ideal", "Gap between 5m VWMA and 15s WMA is at or below the ideal-gap threshold")
alertcondition(longSetup and gapIdeal,  "LONG setup A+ (ideal gap)",  "LONG setup A+: all conditions met and the VWMA/WMA gap is at or below the ideal threshold")
alertcondition(shortSetup and gapIdeal, "SHORT setup A+ (ideal gap)", "SHORT setup A+: all conditions met and the VWMA/WMA gap is at or below the ideal threshold")
