// MACD Histogram Rate of Rise / Decline
// ------------------------------------------------------------
// For up to three MACDs (each on its own timeframe) this measures:
//  • Rate      – how fast the histogram is rising or falling (change per bar of that timeframe)
//  • Accel     – whether that rise/decline is speeding up or slowing down (change of the rate)
//  • Color     – TRON scheme: Aqua (above 0, rising), Blue (above 0, falling),
//                Red (below 0, falling), Burgundy (below 0, rising)
//  • Duration  – how many bars the histogram has been in its current color
//  • Turn speed – on every Red→Burgundy (rise turn) and Aqua→Blue (decline turn), how fast the
//                turn was compared with that MACD's own recent turns (percentile). "Fast" turns are
//                marked and alertable.
//  • Depth     – how far from zero the histogram got before turning (deep vs shallow Burgundy/Blue),
//                ranked against that MACD's recent turns.
//  • Back to 0 – during Burgundy/Blue, how much of the way back to zero the histogram has come
//                (0% = still at its deepest point, 100% = back at zero).
//
// Rates can be ATR-scaled (divided by that timeframe's ATR 14) so quiet and volatile periods compare.
//
// Note: test any trading rule built on this with REGULAR candles. On Heikin Ashi charts the MACD
// is calculated from smoothed HA prices, and results measured on HA prices are overstated.

//@version=6
indicator("MACD Histogram Rate of Rise/Decline", shorttitle = "Hist Rate", overlay = false, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
grpG      = "General"
sigType   = input.string("SMA", "Signal line MA type", options = ["SMA", "EMA"], group = grpG,
     tooltip = "SMA matches your TRON / chart MACDs. EMA is the classic MACD.")
noRepaint = input.bool(true, "Higher-timeframe MACDs: use last CLOSED bar", group = grpG,
     tooltip = "On: a higher-timeframe MACD only updates when its bar closes, so past values and turn marks never change.\nOff: it updates live while the higher-timeframe bar is forming (can flip back and forth).")
normMode  = input.string("ATR-scaled", "Rate units", options = ["ATR-scaled", "Points"], group = grpG,
     tooltip = "ATR-scaled: histogram change per bar divided by that timeframe's ATR(14), comparable across quiet and volatile periods.\nPoints: raw histogram change per bar.")
turnLook  = input.int(200, "Turns remembered for speed ranking", minval = 20, maxval = 2000, group = grpG,
     tooltip = "Each new turn is ranked against this many previous turns of the same MACD and direction.")
fastPct   = input.float(67, "Fast turn = faster than this % of past turns", minval = 50, maxval = 99, step = 1, group = grpG)
deepPct   = input.float(67, "Deep turn = deeper than this % of past turns", minval = 50, maxval = 99, step = 1, group = grpG)
depthFilt = input.string("Any depth", "Fast-turn marks & alerts: depth", options = ["Any depth", "Deep only", "Not deep"], group = grpG,
     tooltip = "Regular-candle test (NAS100 5m, Aug-Nov): on 8/22/9 and 12/30/12, deep turns did slightly better than shallow ones. On 72/200/12 the opposite: deep Burgundy turns reached zero only 14% of the time and lost money (a bounce inside a strong downtrend). None of these were profitable on their own.")

grp1 = "MACD 1"
on1  = input.bool(true, "Enable", group = grp1, inline = "1a")
tf1  = input.timeframe("", "Timeframe", group = grp1, inline = "1a", tooltip = "Empty = chart timeframe. Use the chart timeframe or higher.")
f1   = input.int(8,  "Fast",   minval = 1, group = grp1, inline = "1b")
s1   = input.int(22, "Slow",   minval = 1, group = grp1, inline = "1b")
g1   = input.int(9,  "Signal", minval = 1, group = grp1, inline = "1b")

grp2 = "MACD 2"
on2  = input.bool(true, "Enable", group = grp2, inline = "2a")
tf2  = input.timeframe("", "Timeframe", group = grp2, inline = "2a", tooltip = "Empty = chart timeframe. Use the chart timeframe or higher.")
f2   = input.int(12, "Fast",   minval = 1, group = grp2, inline = "2b")
s2   = input.int(30, "Slow",   minval = 1, group = grp2, inline = "2b")
g2   = input.int(12, "Signal", minval = 1, group = grp2, inline = "2b")

grp3 = "MACD 3"
on3  = input.bool(true, "Enable", group = grp3, inline = "3a")
tf3  = input.timeframe("", "Timeframe", group = grp3, inline = "3a", tooltip = "Empty = chart timeframe. Use the chart timeframe or higher.")
f3   = input.int(72,  "Fast",   minval = 1, group = grp3, inline = "3b")
s3   = input.int(200, "Slow",   minval = 1, group = grp3, inline = "3b")
g3   = input.int(12,  "Signal", minval = 1, group = grp3, inline = "3b")

grpP      = "Display"
paneSel   = input.string("MACD 1", "Pane shows MACD", options = ["MACD 1", "MACD 2", "MACD 3"], group = grpP)
paneMode  = input.string("Histogram", "Pane shows", options = ["Histogram", "Rate (rise/decline speed)", "Acceleration"], group = grpP)
showMarks = input.bool(true, "Mark fast turns of the pane MACD", group = grpP)
showTable = input.bool(true, "Show table", group = grpP)
tblPos    = input.string("Top Right", "Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpP)
colAqua   = input.color(color.aqua,             "Aqua (above 0, rising)",    group = grpP)
colBlue   = input.color(color.blue,             "Blue (above 0, falling)",   group = grpP)
colRed    = input.color(color.red,              "Red (below 0, falling)",    group = grpP)
colBurg   = input.color(color.rgb(128, 0, 32),  "Burgundy (below 0, rising)", group = grpP)

// ───────────────────────────── Core (runs on each MACD's own timeframe) ─────────────────────────────
// Returns values shifted by `off` bars (1 = last closed bar, for the non-repainting option).
f_core(simple int f, simple int s, simple int g, simple bool useSma, simple int off) =>
    m    = ta.ema(close, f) - ta.ema(close, s)
    sgS  = ta.sma(m, g)
    sgE  = ta.ema(m, g)
    h    = m - (useSma ? sgS : sgE)
    dh   = h - h[1]                       // rate of rise (+) / decline (-) per bar
    ddh  = dh - dh[1]                     // acceleration
    atr  = ta.atr(14)
    st   = h > 0 and dh > 0 ? 0 : h > 0 and dh < 0 ? 1 : h <= 0 and dh < 0 ? 2 : h <= 0 and dh > 0 ? 3 : -1
    bars = ta.barssince(st != st[1]) + 1  // bars in the current color
    tUp  = st[1] == 2 and st == 3         // Red -> Burgundy (rise turn)
    tDn  = st[1] == 0 and st == 1         // Aqua -> Blue (decline turn)
    spd  = atr > 0 ? math.abs(dh) / atr : na
    pr   = ta.percentrank(spd, 200)       // current |rate| vs the last 200 bars (0-100)
    // Deepest point of the current excursion below zero (or highest above zero)
    below = h <= 0
    var float ext = na
    ext := na(ext) or below != below[1] ? h : below ? math.min(ext, h) : math.max(ext, h)
    dep  = atr > 0 ? math.abs(ext) / atr : na                 // depth of this excursion, in ATRs
    prog = ext != 0 and not na(ext) ? 1.0 - h / ext : na      // 0 = at the extreme, 1 = back at zero
    [h[off], dh[off], ddh[off], atr[off], st[off], bars[off], tUp[off], tDn[off], pr[off], dep[off], prog[off]]

// Percent of values in `arr` that are <= x (needs at least 10 stored turns)
f_rank(array<float> arr, float x) =>
    int n = array.size(arr)
    float r = na
    if n >= 10
        int cnt = 0
        for v in arr
            if v <= x
                cnt += 1
        r := 100.0 * cnt / n
    r

// One MACD: request its timeframe, detect turns once per bar of that timeframe, rank turn speed.
f_macd(simple string tf, simple int f, simple int s, simple int g) =>
    tfE  = tf == "" ? timeframe.period : tf
    htf  = timeframe.in_seconds(tfE) > timeframe.in_seconds(timeframe.period)
    off  = noRepaint and htf ? 1 : 0
    lk   = noRepaint and htf ? barmerge.lookahead_on : barmerge.lookahead_off
    [h, dh, ddh, atr, st, bars, tUp, tDn, pr, dep, prog] = request.security(syminfo.tickerid, tfE, f_core(f, s, g, sigType == "SMA", off), lookahead = lk)
    isNew = timeframe.change(tfE)
    evUp  = tUp and (not tUp[1] or isNew)
    evDn  = tDn and (not tDn[1] or isNew)
    spd   = atr > 0 ? math.abs(dh) / atr : na
    rate  = normMode == "ATR-scaled" ? (atr > 0 ? dh / atr : na) : dh
    acc   = normMode == "ATR-scaled" ? (atr > 0 ? ddh / atr : na) : ddh
    var array<float> upHist = array.new<float>()
    var array<float> dnHist = array.new<float>()
    var array<float> upDep  = array.new<float>()
    var array<float> dnDep  = array.new<float>()
    var float lastDepPct = na
    float upDepPct = na
    float dnDepPct = na
    var float lastPct = na
    var int   lastDir = 0
    var int   lastBar = na
    float upPct = na
    float dnPct = na
    if evUp and not na(spd)
        upPct := f_rank(upHist, spd)
        array.push(upHist, spd)
        if array.size(upHist) > turnLook
            array.shift(upHist)
        upDepPct := f_rank(upDep, dep)
        array.push(upDep, dep)
        if array.size(upDep) > turnLook
            array.shift(upDep)
        lastDepPct := upDepPct
        lastPct := upPct
        lastDir := 1
        lastBar := bar_index
    if evDn and not na(spd)
        dnPct := f_rank(dnHist, spd)
        array.push(dnHist, spd)
        if array.size(dnHist) > turnLook
            array.shift(dnHist)
        dnDepPct := f_rank(dnDep, dep)
        array.push(dnDep, dep)
        if array.size(dnDep) > turnLook
            array.shift(dnDep)
        lastDepPct := dnDepPct
        lastPct := dnPct
        lastDir := -1
        lastBar := bar_index
    [h, rate, acc, st, bars, upPct, dnPct, pr, lastPct, lastDir, lastBar, dep, prog, upDepPct, dnDepPct, lastDepPct]

[h1, r1, a1, st1, b1, up1, dp1, pr1, lp1, ld1, lb1, dep1, prg1, ud1, dd1, ldp1] = f_macd(tf1, f1, s1, g1)
[h2, r2, a2, st2, b2, up2, dp2, pr2, lp2, ld2, lb2, dep2, prg2, ud2, dd2, ldp2] = f_macd(tf2, f2, s2, g2)
[h3, r3, a3, st3, b3, up3, dp3, pr3, lp3, ld3, lb3, dep3, prg3, ud3, dd3, ldp3] = f_macd(tf3, f3, s3, g3)

// Fast turns (optionally filtered by depth)
f_depOk(float dpct) =>
    depthFilt == "Any depth" ? true : na(dpct) ? false : depthFilt == "Deep only" ? dpct >= deepPct : dpct < deepPct
fu1 = on1 and not na(up1) and up1 >= fastPct and f_depOk(ud1)
fd1 = on1 and not na(dp1) and dp1 >= fastPct and f_depOk(dd1)
fu2 = on2 and not na(up2) and up2 >= fastPct and f_depOk(ud2)
fd2 = on2 and not na(dp2) and dp2 >= fastPct and f_depOk(dd2)
fu3 = on3 and not na(up3) and up3 >= fastPct and f_depOk(ud3)
fd3 = on3 and not na(dp3) and dp3 >= fastPct and f_depOk(dd3)

// ───────────────────────────── Pane ─────────────────────────────
f_col(int st) =>
    switch st
        0 => colAqua
        1 => colBlue
        2 => colRed
        3 => colBurg
        => color.gray

selH  = paneSel == "MACD 1" ? h1  : paneSel == "MACD 2" ? h2  : h3
selR  = paneSel == "MACD 1" ? r1  : paneSel == "MACD 2" ? r2  : r3
selA  = paneSel == "MACD 1" ? a1  : paneSel == "MACD 2" ? a2  : a3
selSt = paneSel == "MACD 1" ? st1 : paneSel == "MACD 2" ? st2 : st3
selFu = paneSel == "MACD 1" ? fu1 : paneSel == "MACD 2" ? fu2 : fu3
selFd = paneSel == "MACD 1" ? fd1 : paneSel == "MACD 2" ? fd2 : fd3
paneVal = paneMode == "Histogram" ? selH : paneMode == "Acceleration" ? selA : selR

plot(paneVal, "Pane value", color = f_col(selSt), style = plot.style_columns)
hline(0, "Zero", color = color.new(color.gray, 40))
plotshape(showMarks and selFu, "Fast rise turn (Red→Burgundy)",  shape.triangleup,   location.bottom, colAqua, size = size.tiny)
plotshape(showMarks and selFd, "Fast decline turn (Aqua→Blue)",  shape.triangledown, location.top,    colRed,  size = size.tiny)

// Data window / CSV export columns
plot(r1,  "MACD1 rate",  display = display.data_window)
plot(a1,  "MACD1 accel", display = display.data_window)
plot(st1, "MACD1 color (0 aqua 1 blue 2 red 3 burgundy)", display = display.data_window)
plot(nz(up1, nz(dp1, na)), "MACD1 turn speed pct", display = display.data_window)
plot(dep1, "MACD1 depth (ATR)", display = display.data_window)
plot(prg1, "MACD1 back to zero (0-1)", display = display.data_window)
plot(r2,  "MACD2 rate",  display = display.data_window)
plot(a2,  "MACD2 accel", display = display.data_window)
plot(st2, "MACD2 color (0 aqua 1 blue 2 red 3 burgundy)", display = display.data_window)
plot(nz(up2, nz(dp2, na)), "MACD2 turn speed pct", display = display.data_window)
plot(dep2, "MACD2 depth (ATR)", display = display.data_window)
plot(prg2, "MACD2 back to zero (0-1)", display = display.data_window)
plot(r3,  "MACD3 rate",  display = display.data_window)
plot(a3,  "MACD3 accel", display = display.data_window)
plot(st3, "MACD3 color (0 aqua 1 blue 2 red 3 burgundy)", display = display.data_window)
plot(nz(up3, nz(dp3, na)), "MACD3 turn speed pct", display = display.data_window)
plot(dep3, "MACD3 depth (ATR)", display = display.data_window)
plot(prg3, "MACD3 back to zero (0-1)", display = display.data_window)

// ───────────────────────────── Table ─────────────────────────────
f_pos(s) =>
    switch s
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

var table tbl = table.new(f_pos(tblPos), 11, 4, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)

f_cell(c, r, txt, tc, bg) =>
    table.cell(tbl, c, r, txt, text_color = tc, bgcolor = bg, text_size = size.small, text_halign = text.align_left)

f_stName(int st) =>
    st == 0 ? "Aqua ▲" : st == 1 ? "Blue ▼" : st == 2 ? "Red ▼" : st == 3 ? "Burgundy ▲" : "—"

fmtR = normMode == "ATR-scaled" ? "+0.0000;-0.0000" : "+0.00;-0.00"

f_depName(float dpct) =>
    na(dpct) ? "" : dpct >= deepPct ? "deep" : dpct <= 100 - deepPct ? "shallow" : "medium"

f_lastTurn(float pct, int dir, int lb, float dpct) =>
    string cls = na(pct) ? "learning" : pct >= fastPct ? "FAST" : pct <= 100 - fastPct ? "slow" : "normal"
    na(lb) ? "none yet" : (dir == 1 ? "Rise " : "Decline ") + cls + (na(pct) ? "" : " (" + str.tostring(pct, "0") + "th pct)") + (na(dpct) ? "" : ", " + f_depName(dpct) + " (" + str.tostring(dpct, "0") + "th)") + ", " + str.tostring(bar_index - lb) + " bars ago"

f_row(int r, bool on, string tf, int f, int s, int g, float h, float rt, float ac, int st, int bars, float pr, float lp, int ld, int lb, float dp, float pg, float ldp) =>
    tfTxt = tf == "" ? timeframe.period : tf
    noBg = color.new(color.black, 100)
    f_cell(0, r, "MACD " + str.tostring(r), color.white, noBg)
    f_cell(1, r, tfTxt + "  " + str.tostring(f) + "/" + str.tostring(s) + "/" + str.tostring(g), color.white, noBg)
    if on
        f_cell(2, r, f_stName(st), color.white, color.new(f_col(st), 30))
        f_cell(3, r, str.tostring(h, "+0.000;-0.000"), color.white, noBg)
        f_cell(4, r, str.tostring(rt, fmtR), rt > 0 ? colAqua : rt < 0 ? colRed : color.gray, noBg)
        f_cell(5, r, str.tostring(ac, fmtR) + (ac * rt > 0 ? "  speeding up" : ac * rt < 0 ? "  slowing" : ""), color.white, noBg)
        f_cell(6, r, na(pr) ? "—" : str.tostring(pr, "0") + "th", color.white, noBg)
        f_cell(7, r, na(bars) ? "—" : str.tostring(bars), color.white, noBg)
        f_cell(8, r, na(dp) ? "—" : str.tostring(dp, "0.00") + " ATR", color.white, noBg)
        f_cell(9, r, (st == 1 or st == 3) and not na(pg) ? str.tostring(pg * 100, "0") + "%" : "—", color.white, noBg)
        f_cell(10, r, f_lastTurn(lp, ld, lb, ldp), na(lp) ? color.gray : lp >= fastPct ? color.yellow : color.white, noBg)
    else
        f_cell(2, r, "off", color.gray, noBg)

if showTable and barstate.islast
    hdr = color.new(color.black, 100)
    f_cell(0, 0, "",              color.gray, hdr)
    f_cell(1, 0, "TF  settings",  color.gray, hdr)
    f_cell(2, 0, "Color",         color.gray, hdr)
    f_cell(3, 0, "Histogram",     color.gray, hdr)
    f_cell(4, 0, "Rate" + (normMode == "ATR-scaled" ? " (ATR/bar)" : " (pts/bar)"), color.gray, hdr)
    f_cell(5, 0, "Accel",         color.gray, hdr)
    f_cell(6, 0, "Rate rank",     color.gray, hdr)
    f_cell(7, 0, "Bars in color", color.gray, hdr)
    f_cell(8, 0, "Depth from 0",  color.gray, hdr)
    f_cell(9, 0, "Back to 0",     color.gray, hdr)
    f_cell(10, 0, "Last turn",    color.gray, hdr)
    f_row(1, on1, tf1, f1, s1, g1, h1, r1, a1, st1, b1, pr1, lp1, ld1, lb1, dep1, prg1, ldp1)
    f_row(2, on2, tf2, f2, s2, g2, h2, r2, a2, st2, b2, pr2, lp2, ld2, lb2, dep2, prg2, ldp2)
    f_row(3, on3, tf3, f3, s3, g3, h3, r3, a3, st3, b3, pr3, lp3, ld3, lb3, dep3, prg3, ldp3)

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(fu1, "MACD 1 fast rise turn",    "MACD 1: fast Red→Burgundy turn (histogram rising fast below zero)")
alertcondition(fd1, "MACD 1 fast decline turn", "MACD 1: fast Aqua→Blue turn (histogram falling fast above zero)")
alertcondition(fu2, "MACD 2 fast rise turn",    "MACD 2: fast Red→Burgundy turn")
alertcondition(fd2, "MACD 2 fast decline turn", "MACD 2: fast Aqua→Blue turn")
alertcondition(fu3, "MACD 3 fast rise turn",    "MACD 3: fast Red→Burgundy turn")
alertcondition(fd3, "MACD 3 fast decline turn", "MACD 3: fast Aqua→Blue turn")
alertcondition(fu1 or fu2 or fu3, "Any fast rise turn",    "A MACD made a fast Red→Burgundy turn")
alertcondition(fd1 or fd2 or fd3, "Any fast decline turn", "A MACD made a fast Aqua→Blue turn")
